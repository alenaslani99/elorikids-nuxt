# ─── Cloudflare D1 (local dev) ──────────────────────────────────
# For local dev with `nuxt dev`, Nitro can bind a local D1 min instance.
# The binding name MUST be "DB" to match wrangler.toml and server/utils/db.ts

# ─── Production ─────────────────────────────────────────────────
# In production (Cloudflare Pages/Workers), the D1 binding is configured
# in the Cloudflare dashboard — no env vars needed.

# ─── Setup steps ────────────────────────────────────────────────
# 1. Create the D1 database:
#      npx wrangler d1 create elorikids-db
# 2. Copy the database_id from the output into wrangler.toml
# 3. Apply the schema:
#      npx wrangler d1 execute elorikids-db --remote --file server/db/schema.sql
#      npx wrangler d1 execute elorikids-db --local  --file server/db/schema.sql
# 4. Apply the admin elevation migration:
#      npx wrangler d1 execute elorikids-db --remote --file server/db/migrations/0002-admin-elevation.sql
#      npx wrangler d1 execute elorikids-db --local  --file server/db/migrations/0002-admin-elevation.sql

# ─── Owner / Admin ──────────────────────────────────────────────
# The email address of the shop owner. This account gains access
# to the /admin panel (after the security-question gate).
# Must match the email registered in the `users` table.
OWNER_EMAIL=your-email@example.com
