# ─── Cloudflare D1 (local dev) ──────────────────────────────────
# For local dev with `nuxt dev`, Nitro can bind a local D1 min instance.
# The binding name MUST be "DB" to match wrangler.toml and server/utils/db.ts

# ─── Production ─────────────────────────────────────────────────
# In production (Cloudflare Pages/Workers), the D1 binding is configured
# in the Cloudflare dashboard - no env vars needed.

# ─── Setup steps ────────────────────────────────────────────────
# 1. Create the D1 database:
#      npx wrangler d1 create elorikids-db
# 2. Copy the database_id from the output into wrangler.toml
# 3. Apply the schema:
#      npx wrangler d1 execute elorikids-db --remote --file server/db/schema.sql
#      npx wrangler d1 execute elorikids-db --local  --file server/db/schema.sql

# ─── Google sign-in (the only way to log in) ────────────────────
# OAuth client of type "Web application" from the Google Cloud console
# (Google Auth Platform -> Clients). Authorized redirect URI:
#   https://elorikids.rs/api/auth/google/callback
# Both are set as secrets in production:
#   npx wrangler secret put GOOGLE_CLIENT_ID
#   npx wrangler secret put GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Owner / Admin ──────────────────────────────────────────────
# There is no owner env var. The owner is the user row with
# role = 'owner'. Sign in once with the owner's Google account, then:
#   npx wrangler d1 execute elorikids-db --remote --command "UPDATE users SET role = 'owner' WHERE email = 'owner@gmail.com'; DELETE FROM sessions WHERE user_id IN (SELECT id FROM users WHERE role = 'owner');"
# and sign in again. /admin is open for 1 hour after each Google sign-in.

# ─── Bex Express Shipping ───────────────────────────────────────
# Credentials received from api@bex.rs after signing a contract.
# BEX_API_TOKEN  -> X-Auth-Token header on every Bex API request.
# BEX_CLIENT_ID  -> our KlijentId; identifies the SENDER (pickup is
#                  known to Bex from the contract, no address needed).
# Both are secrets: set with `npx wrangler secret put BEX_API_TOKEN`
# and `npx wrangler secret put BEX_CLIENT_ID`.
BEX_API_TOKEN=
BEX_CLIENT_ID=
# Endpoint URLs (non-secret; may live in wrangler.toml [vars]).
# The two endpoints are on DIFFERENT hosts - keep them separate.
BEX_POST_SHIPMENTS_URL=https://api.bex.rs:62503/ship/api/Ship/postShipments
BEX_GET_LABEL_URL=https://integrations.bexexpress.rs/api/Shipments/getLabelWithProperties
